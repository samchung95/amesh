# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.31 AS uv

FROM node:22-bookworm-slim AS node

FROM python:3.12-slim-bookworm AS verify

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    PATH="/workspace/.venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
COPY --from=node /usr/local /usr/local

WORKDIR /workspace

COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --extra runtime --extra dev --no-install-project

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend

COPY harnesses/pi/package.json harnesses/pi/package-lock.json ./harnesses/pi/
RUN npm ci --prefix harnesses/pi

COPY . .
RUN uv sync --frozen --extra runtime --extra dev --no-editable \
    && chmod 0755 scripts/verify-local.sh

ENTRYPOINT ["/bin/sh", "scripts/verify-local.sh"]
CMD ["all"]
