{
  "$defs": {
    "AdmissionBehavior": {
      "enum": [
        "QUEUE",
        "CANCEL",
        "FAIL",
        "REPLACE",
        "SKIP"
      ],
      "title": "AdmissionBehavior",
      "type": "string"
    },
    "AdmissionScope": {
      "enum": [
        "GLOBAL",
        "TENANT",
        "NAMESPACE",
        "FLOW",
        "WORKER_GROUP",
        "KEY"
      ],
      "title": "AdmissionScope",
      "type": "string"
    },
    "CheckActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "flowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flowid"
        },
        "maxAttempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "maxDepth": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Maxdepth",
          "type": "integer"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "type": {
          "enum": [
            "NOTIFY",
            "RUN_FLOW"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "CheckActionDefinition",
      "type": "object"
    },
    "CheckDefinition": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckActionDefinition"
          },
          "maxItems": 10,
          "title": "Actions",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "expression": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "FAIL",
          "enum": [
            "WARN",
            "FAIL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "format": "duration",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "type": {
          "enum": [
            "DURATION",
            "START_DELAY",
            "FRESHNESS",
            "COMPLETION_WINDOW",
            "OUTPUT",
            "EXPRESSION"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "CheckDefinition",
      "type": "object"
    },
    "ConcurrencyLimit": {
      "additionalProperties": false,
      "description": "A versioned DSL concurrency rule shared by flows and tasks.",
      "properties": {
        "behavior": {
          "$ref": "#/$defs/AdmissionBehavior",
          "default": "QUEUE"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "leaseSeconds": {
          "default": 3600,
          "maximum": 604800,
          "minimum": 1,
          "title": "Leaseseconds",
          "type": "integer"
        },
        "limit": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/AdmissionScope"
        },
        "workerGroup": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workergroup"
        }
      },
      "required": [
        "id",
        "scope",
        "limit"
      ],
      "title": "ConcurrencyLimit",
      "type": "object"
    },
    "ConditionErrorPolicy": {
      "enum": [
        "FAIL",
        "FALSE",
        "FALLBACK"
      ],
      "title": "ConditionErrorPolicy",
      "type": "string"
    },
    "ConditionalBranch": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskDefinition"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "condition",
        "tasks"
      ],
      "title": "ConditionalBranch",
      "type": "object"
    },
    "ErrorSelector": {
      "additionalProperties": false,
      "description": "Typed selector applied to one task inside an errors block.",
      "properties": {
        "categories": {
          "default": [],
          "items": {
            "enum": [
              "RETRYABLE",
              "NON_RETRYABLE",
              "CANCELLED",
              "TIMED_OUT",
              "INFRASTRUCTURE",
              "CONFIGURATION",
              "USER_CODE",
              "PLATFORM"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "states": {
          "default": [],
          "items": {
            "enum": [
              "FAILED",
              "CANCELLED"
            ],
            "type": "string"
          },
          "title": "States",
          "type": "array"
        },
        "taskIds": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Taskids",
          "type": "array"
        }
      },
      "title": "ErrorSelector",
      "type": "object"
    },
    "FlowableFailurePolicy": {
      "enum": [
        "FAIL_FAST",
        "CONTINUE_ON_ERROR",
        "COLLECT_ALL"
      ],
      "title": "FlowableFailurePolicy",
      "type": "string"
    },
    "InputDefinition": {
      "additionalProperties": true,
