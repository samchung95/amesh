{
  "$defs": {
    "AdmissionBehavior": {
      "enum": [
        "QUEUE",
        "CANCEL",
        "FAIL",
        "REPLACE",
        "SKIP"
      ],
      "title": "AdmissionBehavior",
      "type": "string"
    },
    "AdmissionScope": {
      "enum": [
        "GLOBAL",
        "TENANT",
        "NAMESPACE",
        "FLOW",
        "WORKER_GROUP",
        "KEY"
      ],
      "title": "AdmissionScope",
      "type": "string"
    },
    "ConcurrencyLimit": {
      "additionalProperties": false,
      "description": "A versioned DSL concurrency rule shared by flows and tasks.",
      "properties": {
        "behavior": {
          "$ref": "#/$defs/AdmissionBehavior",
          "default": "QUEUE"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "leaseSeconds": {
          "default": 3600,
          "maximum": 604800,
          "minimum": 1,
          "title": "Leaseseconds",
          "type": "integer"
        },
        "limit": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/AdmissionScope"
        },
        "workerGroup": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workergroup"
        }
      },
      "required": [
        "id",
        "scope",
        "limit"
      ],
      "title": "ConcurrencyLimit",
      "type": "object"
    },
    "FlowableFailurePolicy": {
      "enum": [
        "FAIL_FAST",
        "CONTINUE_ON_ERROR",
        "COLLECT_ALL"
      ],
      "title": "FlowableFailurePolicy",
      "type": "string"
    },
    "InputDefinition": {
      "additionalProperties": true,
      "properties": {
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "InputDefinition",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoffMultiplier": {
          "default": 1,
          "minimum": 1,
          "title": "Backoffmultiplier",
          "type": "number"
        },
        "delaySeconds": {
          "default": 0,
          "minimum": 0,
          "title": "Delayseconds",
          "type": "number"
        },
        "jitterRatio": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Jitterratio",
          "type": "number"
        },
        "maxAttempts": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "maxIntervalSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxintervalseconds"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "RunnableTaskContract": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        },
        "resourceLimits": {
          "$ref": "#/$defs/TaskResourceLimits"
        },
        "secretScopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secretscopes",
          "type": "array"
        }
      },
      "title": "RunnableTaskContract",
      "type": "object"
    },
    "TaskCacheInvalidationPolicy": {
      "enum": [
        "TTL_AND_REVISION",
        "MANUAL"
      ],
      "title": "TaskCacheInvalidationPolicy",
      "type": "string"
    },
    "TaskCachePolicy": {
      "additionalProperties": false,
      "description": "Kestra-compatible task cache controls plus AMESH scoping extensions.",
      "properties": {
        "codeVersion": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codeversion"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "invalidationPolicy": {
          "$ref": "#/$defs/TaskCacheInvalidationPolicy",
          "default": "TTL_AND_REVISION"
        },
        "keyContext": {
          "default": [
            "inputs",
            "variables",
            "labels",
            "trigger",
            "iteration"
          ],
          "items": {
            "enum": [
              "inputs",
              "variables",
              "labels",
              "trigger",
              "iteration"
            ],
            "type": "string"
          },
          "title": "Keycontext",
          "type": "array"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "scope": {
          "$ref": "#/$defs/TaskCacheScope",
          "default": "TASK"
        },
        "ttl": {
          "anyOf": [
            {
              "format": "duration",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl"
        }
      },
      "title": "TaskCachePolicy",
      "type": "object"
    },
    "TaskCacheScope": {
      "enum": [
        "TASK",
        "FLOW",
        "NAMESPACE"
      ],
      "title": "TaskCacheScope",
      "type": "string"
    },
    "TaskDefinition": {
      "additionalProperties": true,
      "properties": {
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "concurrency": {
          "items": {
            "$ref": "#/$defs/ConcurrencyLimit"
          },
          "title": "Concurrency",
          "type": "array"
        },
        "contract": {
          "$ref": "#/$defs/RunnableTaskContract"
        },
        "dependsOn": {
          "items": {
            "type": "string"
          },
          "title": "Dependson",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "failurePolicy": {
          "$ref": "#/$defs/FlowableFailurePolicy",
          "default": "FAIL_FAST"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "maxConcurrency": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxconcurrency"
        },
        "priority": {
          "default": 0,
          "maximum": 1000,
          "minimum": -1000,
          "title": "Priority",
          "type": "integer"
        },
        "resources": {
          "additionalProperties": true,
          "title": "Resources",
          "type": "object"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "runIf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runif"
        },
        "taskCache": {
          "$ref": "#/$defs/TaskCachePolicy"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskDefinition"
          },
          "title": "Tasks",
          "type": "array"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutseconds"
        },
        "type": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "workerGroup": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workergroup"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "TaskDefinition",
      "type": "object"
    },
    "TaskResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "maxArtifactBytes": {
          "default": 104857600,
          "minimum": 1,
          "title": "Maxartifactbytes",
          "type": "integer"
        },
        "maxLogBytes": {
          "default": 1048576,
          "minimum": 1,
          "title": "Maxlogbytes",
          "type": "integer"
        },
        "maxOutputBytes": {
          "default": 1048576,
          "minimum": 1,
          "title": "Maxoutputbytes",
          "type": "integer"
        }
      },
      "title": "TaskResourceLimits",
      "type": "object"
    },
    "TriggerDefinition": {
      "additionalProperties": true,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "cron": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cron"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "flowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flowid"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "interval": {
          "anyOf": [
            {
              "format": "duration",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "maxAttempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "maxCatchUp": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maxcatchup",
          "type": "integer"
        },
        "maxDepth": {
          "default": 16,
          "maximum": 100,
          "minimum": 1,
          "title": "Maxdepth",
          "type": "integer"
        },
        "maxPending": {
          "default": 1000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Maxpending",
          "type": "integer"
        },
        "misfireGraceSeconds": {
          "default": 60,
          "minimum": 0,
          "title": "Misfiregraceseconds",
          "type": "integer"
        },
        "misfirePolicy": {
          "default": "SKIP",
          "enum": [
            "SKIP",
            "CATCH_UP",
            "COALESCE",
            "BACKFILL"
          ],
          "title": "Misfirepolicy",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        },
        "retryDelay": {
          "default": "PT30S",
          "format": "duration",
          "title": "Retrydelay",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "states": {
          "default": [
            "SUCCESS"
          ],
          "items": {
            "enum": [
              "CANCELLED",
              "SUCCESS",
              "FAILED",
              "WARNING"
            ],
            "type": "string"
          },
          "title": "States",
          "type": "array"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "type": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "TriggerDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "annotations": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Annotations",
      "type": "object"
    },
    "apiVersion": {
      "const": "amesh.flow/v1",
      "default": "amesh.flow/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "concurrency": {
      "items": {
        "$ref": "#/$defs/ConcurrencyLimit"
      },
      "title": "Concurrency",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "disabled": {
      "default": false,
      "title": "Disabled",
      "type": "boolean"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/TaskDefinition"
      },
      "title": "Errors",
      "type": "array"
    },
    "finally": {
      "items": {
        "$ref": "#/$defs/TaskDefinition"
      },
      "title": "Finally",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputDefinition"
      },
      "title": "Inputs",
      "type": "array"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "namespace": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "outputs": {
      "additionalProperties": true,
      "title": "Outputs",
      "type": "object"
    },
    "priority": {
      "default": 0,
      "maximum": 1000,
      "minimum": -1000,
      "title": "Priority",
      "type": "integer"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "system": {
      "default": false,
      "title": "System",
      "type": "boolean"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskDefinition"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "timeoutSeconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeoutseconds"
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/TriggerDefinition"
      },
      "title": "Triggers",
      "type": "array"
    },
    "variables": {
      "additionalProperties": true,
      "title": "Variables",
      "type": "object"
    }
  },
  "required": [
    "id",
    "namespace",
    "tasks"
  ],
  "title": "FlowDefinition",
  "type": "object"
}
