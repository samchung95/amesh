          "default": null,
          "title": "Cursor"
        },
        "definition": {
          "additionalProperties": true,
          "title": "Definition",
          "type": "object"
        },
        "maxInFlight": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Maxinflight",
          "type": "integer"
        }
