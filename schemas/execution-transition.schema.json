{
  "$defs": {
    "ExecutionEvent": {
      "properties": {
        "actor_id": {
          "default": "system",
          "title": "Actor Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/ExecutionEventType"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "ExecutionEvent",
      "type": "object"
    },
    "ExecutionEventType": {
      "enum": [
        "ExecutionCreated",
        "ExecutionQueued",
        "ExecutionStarted",
        "ExecutionPaused",
        "ExecutionResumed",
        "ExecutionCancelRequested",
        "ExecutionCancelled",
        "ExecutionSucceeded",
        "ExecutionFailed",
        "ExecutionWarned",
        "ExecutionRestartRequested"
      ],
      "title": "ExecutionEventType",
      "type": "string"
    },
    "ExecutionSnapshot": {
      "properties": {
        "applied_event_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Applied Event Ids",
          "type": "array"
        },
        "applied_idempotency_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Applied Idempotency Keys",
          "type": "array"
        },
        "epoch": {
          "default": 1,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "flow_id": {
          "title": "Flow Id",
          "type": "string"
        },
        "flow_revision": {
          "minimum": 1,
          "title": "Flow Revision",
          "type": "integer"
        },
        "last_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Event At"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState",
          "default": "CREATED"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "version": {
          "default": 0,
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "execution_id",
        "tenant_id",
        "namespace",
        "flow_id",
        "flow_revision"
      ],
      "title": "ExecutionSnapshot",
      "type": "object"
    },
    "ExecutionState": {
      "enum": [
        "CREATED",
        "QUEUED",
        "RUNNING",
        "PAUSED",
        "CANCELLING",
        "CANCELLED",
        "SUCCESS",
        "FAILED",
        "WARNING",
        "RESTARTING"
      ],
      "title": "ExecutionState",
      "type": "string"
    },
    "TaskRunState": {
      "enum": [
        "WAITING",
        "RUNNING",
        "RETRY_DELAY",
        "SUCCESS",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TaskRunState",
      "type": "string"
    },
    "TransitionRejection": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_type": {
          "enum": [
            "execution",
            "task_run"
          ],
          "title": "Aggregate Type",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "code": {
          "$ref": "#/$defs/TransitionRejectionCode"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "current_epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Epoch"
        },
        "current_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionState"
            },
            {
              "$ref": "#/$defs/TaskRunState"
            }
          ],
          "title": "Current State"
        },
        "current_version": {
          "minimum": 0,
          "title": "Current Version",
          "type": "integer"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rejection_id": {
          "format": "uuid",
          "title": "Rejection Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "rejection_id",
        "command_id",
        "idempotency_key",
        "aggregate_type",
        "aggregate_id",
        "code",
        "current_state",
        "current_version",
        "actor_id",
        "reason",
        "correlation_id",
        "occurred_at"
      ],
      "title": "TransitionRejection",
      "type": "object"
    },
    "TransitionRejectionCode": {
      "enum": [
        "ILLEGAL_TRANSITION",
        "VERSION_CONFLICT",
        "EPOCH_CONFLICT"
      ],
      "title": "TransitionRejectionCode",
      "type": "string"
    }
  },
  "properties": {
    "duplicate": {
      "default": false,
      "title": "Duplicate",
      "type": "boolean"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExecutionEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "rejection": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransitionRejection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshot": {
      "$ref": "#/$defs/ExecutionSnapshot"
    }
  },
  "required": [
    "snapshot"
  ],
  "title": "ExecutionTransition",
  "type": "object"
}
