{
  "$defs": {
    "ExecutionState": {
      "enum": [
        "CREATED",
        "QUEUED",
        "RUNNING",
        "PAUSED",
        "CANCELLING",
        "CANCELLED",
        "SUCCESS",
        "FAILED",
        "WARNING",
        "RESTARTING"
      ],
      "title": "ExecutionState",
      "type": "string"
    },
    "TaskRunEvent": {
      "properties": {
        "actor_id": {
          "default": "system",
          "title": "Actor Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/TaskRunEventType"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "TaskRunEvent",
      "type": "object"
    },
    "TaskRunEventType": {
      "enum": [
        "TaskRunCreated",
        "TaskRunStarted",
        "TaskRunRetryScheduled",
        "TaskRunSucceeded",
        "TaskRunFailed",
        "TaskRunCancelled",
        "TaskRunRestarted"
      ],
      "title": "TaskRunEventType",
      "type": "string"
    },
    "TaskRunSnapshot": {
      "properties": {
        "applied_event_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Applied Event Ids",
          "type": "array"
        },
        "applied_idempotency_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Applied Idempotency Keys",
          "type": "array"
        },
        "current_attempt": {
          "default": 0,
          "minimum": 0,
          "title": "Current Attempt",
          "type": "integer"
        },
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "last_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Event At"
        },
        "state": {
          "$ref": "#/$defs/TaskRunState",
          "default": "WAITING"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_run_id": {
          "format": "uuid",
          "title": "Task Run Id",
          "type": "string"
        },
        "version": {
          "default": 0,
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "task_run_id",
        "execution_id",
        "task_id"
      ],
      "title": "TaskRunSnapshot",
      "type": "object"
    },
    "TaskRunState": {
      "enum": [
        "WAITING",
        "RUNNING",
        "RETRY_DELAY",
        "SUCCESS",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TaskRunState",
      "type": "string"
    },
    "TransitionRejection": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_type": {
          "enum": [
            "execution",
            "task_run"
          ],
          "title": "Aggregate Type",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "code": {
          "$ref": "#/$defs/TransitionRejectionCode"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "current_epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Epoch"
        },
        "current_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionState"
            },
            {
              "$ref": "#/$defs/TaskRunState"
            }
          ],
          "title": "Current State"
        },
        "current_version": {
          "minimum": 0,
          "title": "Current Version",
          "type": "integer"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rejection_id": {
          "format": "uuid",
          "title": "Rejection Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "rejection_id",
        "command_id",
        "idempotency_key",
        "aggregate_type",
        "aggregate_id",
        "code",
        "current_state",
        "current_version",
        "actor_id",
        "reason",
        "correlation_id",
        "occurred_at"
      ],
      "title": "TransitionRejection",
      "type": "object"
    },
    "TransitionRejectionCode": {
      "enum": [
        "ILLEGAL_TRANSITION",
        "VERSION_CONFLICT",
        "EPOCH_CONFLICT"
      ],
      "title": "TransitionRejectionCode",
      "type": "string"
    }
  },
  "properties": {
    "duplicate": {
      "default": false,
      "title": "Duplicate",
      "type": "boolean"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskRunEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "rejection": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransitionRejection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshot": {
      "$ref": "#/$defs/TaskRunSnapshot"
    }
  },
  "required": [
    "snapshot"
  ],
  "title": "TaskRunTransition",
  "type": "object"
}
