{
  "description": "Versioned payload stored in the PostgreSQL durable work queue.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "message_type": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Message Type",
      "type": "string"
    },
    "partition_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Partition Key",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_context": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Trace Context",
      "type": "object"
    }
  },
  "required": [
    "message_id",
    "message_type",
    "schema_version",
    "tenant_id",
    "partition_key",
    "correlation_id",
    "produced_at",
    "payload"
  ],
  "title": "DurableEnvelope",
  "type": "object"
}
