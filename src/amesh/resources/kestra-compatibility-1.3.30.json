          "exitCodes": {"0": "batch imported and reconciled", "1": "reconciliation difference", "2": "input error"},
          "machineOutput": "MigrationImportResult JSON plus reconciliation"
        },
        {
          "command": "amesh kestra compatibility manifest",
          "flags": ["global --output {human,json,quiet} before kestra"],
          "exitCodes": {"0": "manifest emitted", "2": "input error"},
