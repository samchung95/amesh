# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.31 AS uv

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/amesh-docs \
    PATH="/opt/amesh-docs/bin:$PATH"

COPY --from=uv /uv /uvx /bin/

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group docs --no-install-project

COPY mkdocs.yml ./
COPY docs ./docs

RUN useradd --create-home --uid 10001 docs \
    && mkdir -p .artifacts/docs-site \
    && chown -R docs:docs .artifacts

USER 10001:10001

EXPOSE 8000

ENTRYPOINT ["mkdocs"]
CMD ["serve", "--dev-addr=0.0.0.0:8000"]
