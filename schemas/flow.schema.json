        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "validation": {
          "additionalProperties": true,
          "title": "Validation",
          "type": "object"
        },
        "values": {
          "default": [],
          "items": {},
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "InputDefinition",
      "type": "object"
