{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amesh.dev/schemas/compatibility-inventory/v1",
  "title": "AMESH compatibility inventory",
  "type": "object",
  "required": ["schema_version", "target", "source_registry", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "amesh.compatibility-inventory/v1"},
    "target": {
      "type": "object",
      "required": ["product", "version", "tag", "commit", "release_date"],
      "additionalProperties": false,
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_date": {"type": "string", "format": "date"}
      }
    },
    "source_registry": {"const": "requirements/source-provenance.json"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "epic_id",
          "compatibility_level",
          "implementation_status",
          "disposition",
          "source_ids",
          "evidence",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^URS-F-[0-9]{4}$"},
          "epic_id": {"type": "string", "pattern": "^EPIC-[0-9]{3}$"},
          "compatibility_level": {"type": "string", "minLength": 1},
          "implementation_status": {"enum": ["Proposed", "In Progress", "Verified"]},
          "disposition": {"enum": ["verified", "gap", "deferred", "intentional-difference"]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
