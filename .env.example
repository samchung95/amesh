APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# AMESH_CONFIG_FILES=C:\amesh\base.yaml;C:\amesh\site.yaml
# AMESH_SECRETS_DIR=C:\amesh\secrets
DATABASE_URL=postgresql+asyncpg://amesh:amesh@localhost:5432/amesh
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://amesh:amesh@replica:5432/amesh
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=100
DATABASE_TLS_MODE=disable
# DATABASE_TLS_CA_FILE=/etc/ssl/certs/provider-root.pem
WORKER_RECONCILIATION_INTERVAL_SECONDS=60
WORKER_RECONCILIATION_MAX_REPAIRS=10
WORKER_RECONCILIATION_STUCK_AFTER_SECONDS=300
SERVICE_ROLE=webserver
# SERVICE_INSTANCE_NAME=amesh-web-0
# SERVICE_FAILURE_ZONE=zone-a
SERVICE_HEARTBEAT_SECONDS=5
SERVICE_STALE_AFTER_SECONDS=20
SERVICE_CYCLE_SECONDS=5
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=amesh
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio-development-only
OBJECT_STORAGE_WORKLOAD_IDENTITY=false
OBJECT_STORAGE_ENCRYPTION_KEY_ID=
OBJECT_STORAGE_PROXY_URL=
OBJECT_STORAGE_CA_FILE=
OBJECT_STORAGE_AZURE_ACCOUNT_URL=
OBJECT_STORAGE_AZURE_ACCOUNT_KEY=
OBJECT_STORAGE_GCS_PROJECT=
OBJECT_STORAGE_GCS_ENDPOINT=
OBJECT_STORAGE_GCS_CREDENTIALS_FILE=
OBJECT_STORAGE_CONSISTENCY_ATTEMPTS=5
OBJECT_STORAGE_CONSISTENCY_DELAY_SECONDS=0.1
OBJECT_STORAGE_SPOOL_MEMORY_BYTES=8388608
OBJECT_STORAGE_GC_SAFETY_WINDOW_SECONDS=86400
AUTH_MODE=development
AUTH_POLICY=local
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_SESSION_ROTATION_SECONDS=900
AUTH_SESSION_OVERLAP_SECONDS=30
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=30
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900
AMESH_ADMIN_TOKEN=development-token
KUBERNETES_CONTEXT=
KUBERNETES_TASK_NAMESPACE=amesh-tasks
WORKER_POLL_SECONDS=5
WORKER_RECOVERY_GRACE_SECONDS=120
PRODUCT_TELEMETRY_ENABLED=false
PRODUCT_UPDATE_CHECKS_ENABLED=false
PLUGIN_TRUST_MODE=signed-only
NETWORK_PUBLIC_EXPOSURE=false
NETWORK_TLS_TERMINATED=false
LOG_LEVEL=INFO
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-5.6-luna
