APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://amesh:amesh@localhost:5432/amesh
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://amesh:amesh@replica:5432/amesh
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=100
DATABASE_TLS_MODE=disable
# DATABASE_TLS_CA_FILE=/etc/ssl/certs/provider-root.pem
WORKER_RECONCILIATION_INTERVAL_SECONDS=60
WORKER_RECONCILIATION_MAX_REPAIRS=10
WORKER_RECONCILIATION_STUCK_AFTER_SECONDS=300
SERVICE_ROLE=webserver
# SERVICE_INSTANCE_NAME=amesh-web-0
# SERVICE_FAILURE_ZONE=zone-a
SERVICE_HEARTBEAT_SECONDS=5
SERVICE_STALE_AFTER_SECONDS=20
SERVICE_CYCLE_SECONDS=5
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=amesh
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio-development-only
OBJECT_STORAGE_SECURE=false
AUTH_MODE=development
AMESH_ADMIN_TOKEN=development-token
KUBERNETES_CONTEXT=
KUBERNETES_TASK_NAMESPACE=amesh-tasks
WORKER_POLL_SECONDS=5
WORKER_RECOVERY_GRACE_SECONDS=120
PRODUCT_TELEMETRY_ENABLED=false
LOG_LEVEL=INFO
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-5.6-luna
