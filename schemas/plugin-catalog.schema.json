{
  "$defs": {
    "ExtensionType": {
      "enum": [
        "task",
        "trigger",
        "condition",
        "runner",
        "storage",
        "secret",
        "expression",
        "notification"
      ],
      "title": "ExtensionType",
      "type": "string"
    },
    "PluginCapabilities": {
      "additionalProperties": false,
      "properties": {
        "allowedEgress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowedegress",
          "type": "array"
        },
        "filesystemAccess": {
          "$ref": "#/$defs/PluginFilesystemAccess",
          "default": "none"
        },
        "networkAccess": {
          "$ref": "#/$defs/PluginNetworkAccess",
          "default": "none"
        },
        "required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "secretScopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secretscopes",
          "type": "array"
        }
      },
      "title": "PluginCapabilities",
      "type": "object"
    },
    "PluginCertificationStatus": {
      "enum": [
        "unverified",
        "community",
        "certified"
      ],
      "title": "PluginCertificationStatus",
      "type": "string"
    },
    "PluginCompatibility": {
      "additionalProperties": false,
      "properties": {
        "platformVersion": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Platformversion",
          "type": "string"
        },
        "protocolVersions": {
          "default": [
            "amesh.plugin.rpc/v1"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Protocolversions",
          "type": "array"
        }
      },
      "required": [
        "platformVersion"
      ],
      "title": "PluginCompatibility",
      "type": "object"
    },
    "PluginDependency": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "versionRange": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Versionrange",
          "type": "string"
        }
      },
      "required": [
        "name",
        "versionRange"
      ],
      "title": "PluginDependency",
      "type": "object"
    },
    "PluginDeprecation": {
      "additionalProperties": false,
      "properties": {
        "deprecatedIn": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Deprecatedin",
          "type": "string"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "removedIn": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removedin"
        },
        "replacement": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        },
        "subject": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "deprecatedIn",
        "message"
      ],
      "title": "PluginDeprecation",
      "type": "object"
    },
    "PluginDocumentation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "documentationUrl": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentationurl"
        },
        "examples": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Examples",
          "type": "array"
        },
        "icon": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "propertyOrder": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Propertyorder",
          "type": "array"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category"
      ],
      "title": "PluginDocumentation",
      "type": "object"
    },
    "PluginEntryPoint": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "amesh.extension/v1",
          "default": "amesh.extension/v1",
          "title": "Apiversion",
          "type": "string"
        },
        "configurationSchema": {
          "additionalProperties": true,
          "title": "Configurationschema",
          "type": "object"
        },
        "documentation": {
          "$ref": "#/$defs/PluginDocumentation"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "outputSchema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputschema"
        },
        "resourceType": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourcetype"
        },
        "target": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/PluginTransport"
        },
        "type": {
          "$ref": "#/$defs/ExtensionType"
        }
      },
      "required": [
        "name",
        "type",
        "transport",
        "target",
        "configurationSchema",
        "documentation"
      ],
      "title": "PluginEntryPoint",
      "type": "object"
    },
    "PluginFilesystemAccess": {
      "enum": [
        "none",
        "workspace-read",
        "workspace-write"
      ],
      "title": "PluginFilesystemAccess",
      "type": "string"
    },
    "PluginLifecycleStatus": {
      "enum": [
        "installed",
        "active",
        "deprecated",
        "incompatible",
        "quarantined",
        "yanked"
      ],
      "title": "PluginLifecycleStatus",
      "type": "string"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/PluginCapabilities"
        },
        "compatibility": {
          "$ref": "#/$defs/PluginCompatibility"
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginDependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "deprecations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginDeprecation"
          },
          "title": "Deprecations",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "entryPoints": {
          "items": {
            "$ref": "#/$defs/PluginEntryPoint"
          },
          "minItems": 1,
          "title": "Entrypoints",
          "type": "array"
        },
        "license": {
          "maxLength": 255,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "schemaVersion": {
          "const": "amesh.plugin/v1",
          "default": "amesh.plugin/v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "vendor": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "vendor",
        "license",
        "compatibility",
        "entryPoints"
      ],
      "title": "PluginManifest",
      "type": "object"
    },
    "PluginMarketplaceSignals": {
      "additionalProperties": false,
      "properties": {
        "certification": {
          "$ref": "#/$defs/PluginCertificationStatus",
          "default": "unverified"
        },
        "downloads": {
          "default": 0,
          "minimum": 0,
          "title": "Downloads",
          "type": "integer"
        },
        "lastMaintainedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastmaintainedat"
        },
        "security": {
          "$ref": "#/$defs/PluginSecurityStatus",
          "default": "unknown"
        },
        "trustDisclaimer": {
          "const": "Signals are informational and are not a trust guarantee.",
          "default": "Signals are informational and are not a trust guarantee.",
          "title": "Trustdisclaimer",
          "type": "string"
        }
      },
      "title": "PluginMarketplaceSignals",
      "type": "object"
    },
    "PluginNetworkAccess": {
      "enum": [
        "none",
        "restricted"
      ],
      "title": "PluginNetworkAccess",
      "type": "string"
    },
    "PluginPackageRecord": {
      "properties": {
        "contentDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentdigest"
        },
        "contentPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentpath"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marketplaceSignals": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginMarketplaceSignals"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "registryAttachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginRegistryAttachment"
          },
          "title": "Registryattachments",
          "type": "array"
        },
        "registryMetadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRegistryMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sourceKind": {
          "$ref": "#/$defs/PluginSourceKind"
        },
        "sourceLocation": {
          "title": "Sourcelocation",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PluginLifecycleStatus"
        }
      },
      "required": [
        "sourceKind",
        "sourceLocation",
        "status"
      ],
      "title": "PluginPackageRecord",
      "type": "object"
    },
    "PluginRegistryAttachment": {
      "additionalProperties": false,
      "properties": {
        "blob": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Blob",
          "type": "string"
        },
        "contentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PluginRegistryAttachmentKind"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/PluginRegistrySignature"
        }
      },
      "required": [
        "kind",
        "mediaType",
        "blob",
        "contentDigest",
        "signature"
      ],
      "title": "PluginRegistryAttachment",
      "type": "object"
    },
    "PluginRegistryAttachmentKind": {
      "enum": [
        "sbom",
        "vulnerability-report",
        "provenance"
      ],
      "title": "PluginRegistryAttachmentKind",
      "type": "string"
    },
    "PluginRegistryMetadata": {
      "additionalProperties": false,
      "properties": {
        "changelogUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Changelogurl",
          "type": "string"
        },
        "documentationUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Documentationurl",
          "type": "string"
        },
        "license": {
          "maxLength": 255,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "sdkRange": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sdkrange",
          "type": "string"
        },
        "sourceUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Sourceurl",
          "type": "string"
        },
        "supportedPlatformRange": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Supportedplatformrange",
          "type": "string"
        }
      },
      "required": [
        "license",
        "sourceUrl",
        "documentationUrl",
        "supportedPlatformRange",
        "sdkRange",
        "changelogUrl"
      ],
      "title": "PluginRegistryMetadata",
      "type": "object"
    },
    "PluginRegistrySignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256",
          "default": "hmac-sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "keyId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Keyid",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "keyId",
        "value"
      ],
      "title": "PluginRegistrySignature",
      "type": "object"
    },
    "PluginSecurityStatus": {
      "enum": [
        "unknown",
        "current",
        "advisory",
        "critical"
      ],
      "title": "PluginSecurityStatus",
      "type": "string"
    },
    "PluginSourceKind": {
      "enum": [
        "embedded",
        "directory",
        "registry",
        "offline-bundle"
      ],
      "title": "PluginSourceKind",
      "type": "string"
    },
    "PluginTransport": {
      "enum": [
        "stdio",
        "grpc",
        "http"
      ],
      "title": "PluginTransport",
      "type": "string"
    }
  },
  "properties": {
    "catalogDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalogdigest",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "packages": {
      "items": {
        "$ref": "#/$defs/PluginPackageRecord"
      },
      "title": "Packages",
      "type": "array"
    },
    "schemaVersion": {
      "const": "amesh.plugin-catalog/v1",
      "default": "amesh.plugin-catalog/v1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "generation",
    "catalogDigest",
    "generatedAt",
    "packages"
  ],
  "title": "PluginCatalogSnapshot",
  "type": "object"
}
