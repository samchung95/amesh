{
  "components": {
    "schemas": {
      "ExecutionEvent": {
        "properties": {
          "actor_id": {
            "default": "system",
            "title": "Actor Id",
            "type": "string"
          },
          "causation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Causation Id"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/ExecutionEventType"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "schema_version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "event_type"
        ],
        "title": "ExecutionEvent",
        "type": "object"
      },
      "ExecutionEventType": {
        "enum": [
          "ExecutionCreated",
          "ExecutionQueued",
          "ExecutionStarted",
          "ExecutionPaused",
          "ExecutionResumed",
          "ExecutionCancelRequested",
          "ExecutionCancelled",
          "ExecutionSucceeded",
          "ExecutionFailed",
          "ExecutionWarned",
          "ExecutionRestartRequested"
        ],
        "title": "ExecutionEventType",
        "type": "string"
      },
      "ExecutionSnapshot": {
        "properties": {
          "applied_event_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Applied Event Ids",
            "type": "array"
          },
          "epoch": {
            "default": 1,
            "minimum": 1.0,
            "title": "Epoch",
            "type": "integer"
          },
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "flow_id": {
            "title": "Flow Id",
            "type": "string"
          },
          "flow_revision": {
            "minimum": 1.0,
            "title": "Flow Revision",
            "type": "integer"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ExecutionState",
            "default": "CREATED"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "version": {
            "default": 0,
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "execution_id",
          "tenant_id",
          "namespace",
          "flow_id",
          "flow_revision"
        ],
        "title": "ExecutionSnapshot",
        "type": "object"
      },
      "ExecutionState": {
        "enum": [
          "CREATED",
          "QUEUED",
          "RUNNING",
          "PAUSED",
          "CANCELLING",
          "CANCELLED",
          "SUCCESS",
          "FAILED",
          "WARNING",
          "RESTARTING"
        ],
        "title": "ExecutionState",
        "type": "string"
      },
      "FlowValidationResult": {
        "properties": {
          "canonical": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "semantic_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Hash"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid"
        ],
        "title": "FlowValidationResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReduceExecutionRequest": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/ExecutionEvent"
            },
            "minItems": 1,
            "title": "Events",
            "type": "array"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          }
        },
        "required": [
          "snapshot",
          "events"
        ],
        "title": "ReduceExecutionRequest",
        "type": "object"
      },
      "ReduceExecutionResponse": {
        "properties": {
          "duplicate_events_ignored": {
            "default": 0,
            "title": "Duplicate Events Ignored",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          }
        },
        "required": [
          "snapshot"
        ],
        "title": "ReduceExecutionResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "severity": {
            "default": "error",
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "path"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Initial clean-room durable workflow foundation. This API demonstrates flow validation and deterministic reduction only.",
    "title": "AMESH",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/executions/reduce": {
      "post": {
        "operationId": "reduce_execution_events_api_v1_executions_reduce_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReduceExecutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReduceExecutionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reduce Execution Events",
        "tags": [
          "executions"
        ]
      }
    },
    "/api/v1/flows/validate": {
      "post": {
        "operationId": "validate_flow_api_v1_flows_validate_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowValidationResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Validate Flow",
        "tags": [
          "flows"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "system"
        ]
      }
    }
  }
}
