{
  "$defs": {
    "ExecutionEventType": {
      "enum": [
        "ExecutionCreated",
        "ExecutionQueued",
        "ExecutionStarted",
        "ExecutionPaused",
        "ExecutionResumed",
        "ExecutionCancelRequested",
        "ExecutionCancelled",
        "ExecutionSucceeded",
        "ExecutionFailed",
        "ExecutionWarned",
        "ExecutionRestartRequested"
      ],
      "title": "ExecutionEventType",
      "type": "string"
    }
  },
  "properties": {
    "actor_id": {
      "default": "system",
      "title": "Actor Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/ExecutionEventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "event_type"
  ],
  "title": "ExecutionEvent",
  "type": "object"
}
