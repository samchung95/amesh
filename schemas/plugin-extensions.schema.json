    "ExtensionCallPolicy": {
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "maxInFlight": {
          "default": 1,
          "maximum": 100000,
          "minimum": 1,
          "title": "Maxinflight",
          "type": "integer"
        },
        "retryDelaySeconds": {
          "default": 0,
          "maximum": 300,
          "minimum": 0,
          "title": "Retrydelayseconds",
          "type": "number"
        },
        "timeoutSeconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeoutseconds",
          "type": "number"
        }
      },
      "title": "ExtensionCallPolicy",
      "type": "object"
    },
    "PluginConditionRequest": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        }
      },
      "title": "PluginConditionRequest",
      "type": "object"
    },
    "PluginConditionResult": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "matched",
        "reason"
      ],
      "title": "PluginConditionResult",
      "type": "object"
    },
    "PluginLifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "executionId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Executionid",
          "type": "string"
        },
        "flowId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Flowid",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "occurredAt": {
          "format": "date-time",
          "title": "Occurredat",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "taskRunId": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taskrunid"
        },
        "tenantId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Tenantid",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PluginLifecycleEventType"
        }
      },
      "required": [
        "eventId",
        "type",
        "tenantId",
        "namespace",
        "flowId",
        "executionId",
        "occurredAt"
      ],
      "title": "PluginLifecycleEvent",
      "type": "object"
    },
    "PluginLifecycleEventType": {
      "enum": [
        "execution.started",
        "execution.succeeded",
        "execution.failed",
        "execution.cancelled",
        "task.started",
        "task.succeeded",
        "task.failed",
        "check.triggered"
      ],
      "title": "PluginLifecycleEventType",
      "type": "string"
    },
    "PluginNotificationDeliveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "deliveryKey": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Deliverykey",
          "type": "string"
        },
        "maxAttempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "retryDelaySeconds": {
          "default": 1,
          "maximum": 300,
          "minimum": 0,
          "title": "Retrydelayseconds",
          "type": "number"
        },
        "severity": {
          "default": "INFO",
          "pattern": "^(INFO|WARNING|ERROR|CRITICAL)$",
          "title": "Severity",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeoutseconds",
          "type": "number"
        }
      },
      "required": [
        "deliveryKey",
        "channel"
      ],
      "title": "PluginNotificationDeliveryPolicy",
      "type": "object"
    },
    "PluginNotificationRequest": {
