            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxbytes"
        },
        "placeholder": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
